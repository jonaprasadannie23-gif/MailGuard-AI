# ProbMail Environment Configuration
# Copy to .env and fill in your values. Never commit .env to Git.

# Flask Application Settings
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000

# PostgreSQL Database (Neon / Supabase / RDS)
# When deploying via Vercel + Neon, Vercel automatically populates DATABASE_URL & POSTGRES_URL.
# If running locally or on an external host, configure your connection string here:
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Frontend (Vite) — set this in Vercel Environment Variables for production.
# IMPORTANT: Set this to the backend ORIGIN only — do NOT include /api in the value.
#   The frontend code always appends /api automatically.
# Example for Render backend: VITE_API_URL=https://mailguard-ai-oyh4.onrender.com
# Leave unset when using the Vercel serverless function (api/index.py) as the backend.
VITE_API_URL=
