# ProbMail Environment Configuration
# Copy to .env and fill in your values. Never commit .env to Git.

# Flask backend
FLASK_ENV=development
SECRET_KEY=probmail-secure-secret-key-2026
PORT=5000

# Frontend (Vite) — set this in Vercel Environment Variables for production.
# Value should be the Render backend origin with NO trailing slash.
# Example: VITE_API_URL=https://mailguard-ai-oyh4.onrender.com
VITE_API_URL=
